# Copie este arquivo para .env e preencha. O .env nunca vai para o repositório.

# SQL Server (requer: pip install pyodbc e o "ODBC Driver 17 for SQL Server")
# ETL_DB_URL=mssql+pyodbc://USUARIO:SENHA@SERVIDOR/BANCO?driver=ODBC+Driver+17+for+SQL+Server

# Demonstração local, sem instalar nada:
ETL_DB_URL=sqlite:///demo.db
